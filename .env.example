# Copy to .env.local and fill in. Only EXPO_PUBLIC_* values reach the app, and they ship inside the
# bundle, so never put secrets here.

# hourglass-server base URL including /api, e.g. http://localhost:4000/api
# (Android emulator reaches the host machine at 10.0.2.2, not localhost)
EXPO_PUBLIC_API_URL=

# Google OAuth client IDs (Google Cloud Console > Credentials). Both must be in the server's GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
